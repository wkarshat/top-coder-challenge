   "source": [
    "# Rule-based and Manual Approaches\n",
    "Includes Decision Trees and Manual Rule Mining"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import pandas as pd
",
    "from sklearn.tree import DecisionTreeRegressor, export_text
",
    "import matplotlib.pyplot as plt
",
    "
",
    "df = pd.read_csv('public.csv')
",
    "X = df[['trip_duration_days', 'miles_traveled', 'total_receipts_amount']]
",
    "y = df['expected_output']
",
    "
",
    "# Decision Tree
",
    "tree = DecisionTreeRegressor(max_depth=5, random_state=42)
",
    "tree.fit(X, y)
",
    "print(export_text(tree, feature_names=list(X.columns)))
",
    "
",
    "# Manual Rule Mining
",
    "summary = df.groupby('trip_duration_days')['expected_output'].agg(['mean', 'std', 'count'])
",
    "print('Summary by trip length:\n', summary)
",
    "five_day = df[df['trip_duration_days'] == 5]
",
    "print('5-day trips, sorted by reimbursement:')
",
    "print(five_day.sort_values('expected_output').head(20))
",
    "same_miles = df[df['miles_traveled'] == 100]
",
    "print(same_miles[['total_receipts_amount', 'expected_output']])"
   ],
   "execution_count": None,
   "outputs": []
  }
