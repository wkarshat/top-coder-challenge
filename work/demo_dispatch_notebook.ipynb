    "    {"trip_duration_days": 2, "miles_traveled": 90, "total_receipts_amount": 50.0},\n",
    "    {"trip_duration_days": 7, "miles_traveled": 300, "total_receipts_amount": 510.1},\n",
    "    {"trip_duration_days": 3, "miles_traveled": 150, "total_receipts_amount": 100.0}\n",
    "])\n",
    "df['prediction'] = df.apply(predict_dispatch, axis=1)\n",
    "display(df)"
