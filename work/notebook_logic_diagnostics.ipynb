   "source": [
    "# Logic Diagnostics and Examples\n",
    "Analyze which logic/method was chosen, show intermediate and outlier cases."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import json\n",
    "\n",
    "with open('private_cases.json') as f:\n",
    "    data = json.load(f)\n",
    "df = pd.DataFrame([r['input'] if 'input' in r else r for r in data])"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "def dispatch_explain(row):\n",
    "    days = int(row['trip_duration_days'])\n",
    "    miles = float(row['miles_traveled'])\n",
    "    receipts = float(row['total_receipts_amount'])\n",
    "    if days == 5:\n",
    "        return "5-day rule"\n",
    "    elif miles < 100:\n",
    "        return "short trip"\n",
    "    elif receipts > 500:\n",
    "        return "high receipts"\n",
    "    else:\n",
    "        return "baseline"\n",
    "df['logic_used'] = df.apply(dispatch_explain, axis=1)"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Show counts and sample rows\n",
    "logic_counts = df['logic_used'].value_counts()\n",
    "display(logic_counts)\n",
    "for logic in logic_counts.index:\n",
    "    display(df[df['logic_used'] == logic].head(2))"
   ],
   "execution_count": null,
   "outputs": []
  }
