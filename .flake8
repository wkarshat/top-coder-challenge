[flake8]
max-line-length = 100
ignore = E501,F401,F841,W503,E203,W291,W292,W293,E128,E129,E226,W504,F811,F541
exclude = 
    .git,
    __pycache__,
    venv,
    .venv,
    build,
    dist,
    *.egg-info,
    .pytest_cache
per-file-ignores =
    __init__.py:F401
    */migrations/*:E501,F401
    tests/*:F401,F841 