   "source": [
    "# Logic/Interval Visualization\n",
    "Shows which logic applies for each private case."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def dispatch_explain(row):\n",
    "    days = int(row['trip_duration_days'])\n",
    "    miles = float(row['miles_traveled'])\n",
    "    receipts = float(row['total_receipts_amount'])\n",
    "    if days == 5:\n",
    "        return "5-day rule"\n",
    "    elif miles < 100:\n",
    "        return "short trip"\n",
    "    elif receipts > 500:\n",
    "        return "high receipts"\n",
    "    else:\n",
    "        return "baseline"\n",
    "\n",
    "df = pd.read_csv('private_cases.csv')\n",
    "df['logic_used'] = df.apply(dispatch_explain, axis=1)\n",
    "logic_counts = df['logic_used'].value_counts()\n",
    "logic_counts.plot(kind='bar', title='Logic Used Distribution')\n",
    "plt.ylabel('Count')\n",
    "plt.show()"
   ],
   "execution_count": null,
   "outputs": []
  }
