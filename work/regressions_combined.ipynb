   "source": [
    "# Regression Approaches for Legacy Reimbursement System\n",
    "Includes Linear, Polynomial, and Piecewise Regression"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import pandas as pd
",
    "from sklearn.linear_model import LinearRegression
",
    "from sklearn.preprocessing import PolynomialFeatures
",
    "import matplotlib.pyplot as plt
",
    "import pwlf
",
    "
",
    "df = pd.read_csv('public.csv')
",
    "X = df[['trip_duration_days', 'miles_traveled', 'total_receipts_amount']]
",
    "y = df['expected_output']
",
    "
",
    "# Linear Regression
",
    "reg = LinearRegression().fit(X, y)
",
    "print('Linear Regression R^2 score:', reg.score(X, y))
",
    "
",
    "# Polynomial Regression
",
    "poly = PolynomialFeatures(degree=2)
",
    "X_poly = poly.fit_transform(X)
",
    "reg_poly = LinearRegression().fit(X_poly, y)
",
    "print('Polynomial Regression R^2 score:', reg_poly.score(X_poly, y))
",
    "
",
    "# Piecewise Regression on miles_traveled
",
    "x = df['miles_traveled'].values
",
    "my_pwlf = pwlf.PiecewiseLinFit(x, y)
",
    "breaks = my_pwlf.fit(3)
",
    "y_hat = my_pwlf.predict(x)
",
    "plt.scatter(x, y, s=8, alpha=0.5, label='Actual')
",
    "plt.plot(x, y_hat, color='red', label='Piecewise Fit')
",
    "plt.xlabel('Miles Traveled')
",
    "plt.ylabel('Expected Output')
",
    "plt.title('Piecewise Linear Regression')
",
    "plt.legend()
",
    "plt.show()"
   ],
   "execution_count": None,
   "outputs": []
  }
